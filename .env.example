# Application
AIOPS_APP_NAME=AIOps Copilot
AIOPS_DEBUG=false
AIOPS_HOST=127.0.0.1
AIOPS_PORT=9900
AIOPS_CORS_ORIGINS=http://127.0.0.1:9900,http://localhost:9900
# Local development keeps authentication off. Controlled environments should
# enable it and provide comma-separated secret:role entries.
AIOPS_AUTH_ENABLED=false
AIOPS_API_KEYS=
AIOPS_MAX_CONCURRENT_AGENT_REQUESTS=8
AIOPS_REQUEST_QUEUE_TIMEOUT_SECONDS=1
# Max tools exposed per node in the Plan-Execute-Replan diagnosis graph.
AIOPS_MAX_EXPOSED_TOOLS=12
# false keeps live-tool diagnostics available when Milvus is temporarily down.
AIOPS_MILVUS_REQUIRED_ON_STARTUP=false
# memory for local development; postgres for multi-replica deployments.
AIOPS_CHECKPOINT_BACKEND=memory
AIOPS_CHECKPOINT_POSTGRES_DSN=postgresql://aiops:aiops@127.0.0.1:55432/aiops
AIOPS_CHECKPOINT_REQUIRED=false
AIOPS_COORDINATION_BACKEND=memory
AIOPS_REDIS_URL=redis://127.0.0.1:6389/0
AIOPS_COORDINATION_REQUIRED=false
AIOPS_COORDINATION_KEY_PREFIX=aiops
AIOPS_OTEL_ENABLED=false
OTEL_SERVICE_NAME=aiops-copilot
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
AIOPS_METRICS_BACKEND=process
AIOPS_PROMETHEUS_URL=http://127.0.0.1:9090
AIOPS_TOOL_SLO_SUCCESS_RATE=0.99
AIOPS_TOOL_SLO_P95_MS=5000
AIOPS_DEPENDENCY_MAX_CONCURRENCY=8
AIOPS_DEPENDENCY_QUEUE_TIMEOUT_SECONDS=0.5
AIOPS_CIRCUIT_FAILURE_THRESHOLD=3
AIOPS_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=10
AIOPS_SSE_REPLAY_EVENTS=256

# LLM and embedding
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek OpenAI-compatible API. Keep real keys only in .env.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-v4-flash
LLM_REASONING_MODEL=deepseek-v4-pro
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=320
LLM_MAX_RETRIES=2
# Per-million-token USD prices for /api/metrics/llm cost accounting; 0 disables it.
LLM_PRICE_INPUT_PER_MILLION=0
LLM_PRICE_OUTPUT_PER_MILLION=0
RAG_MODEL=deepseek-v4-flash
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSIONS=1024
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
LOCAL_EMBEDDING_REVISION=79e7739b6ab944e86d6171e44d24c997fc1e0116
LOCAL_EMBEDDING_DEVICE=auto
LOCAL_EMBEDDING_BATCH_SIZE=8
LOCAL_EMBEDDING_CACHE_DIR=
LOCAL_EMBEDDING_SOURCE=huggingface
MODELSCOPE_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
# 国内网络可按需配置可信 Hugging Face 镜像；留空使用官方端点。
HUGGINGFACE_ENDPOINT=

# Milvus / RAG
# Retrieval backend: "local_wiki" (default, zero-dependency SQLite FTS5/BM25,
# compiles aiops-docs/ on startup) or "milvus" (requires Docker + Milvus + BGE
# embeddings for dense vector search).
AIOPS_RETRIEVAL_BACKEND=local_wiki
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=aiops_kb_bge_large_zh_v1_5_v1
MILVUS_COLLECTION_ALIAS=aiops_kb_current
MILVUS_METRIC_TYPE=COSINE
RAG_TOP_K=5
RAG_EXPANSION_MODEL=deepseek-v4-flash
RAG_MULTI_QUERY_COUNT=3
RAG_BRANCH_TOP_K=20
RAG_RRF_K=60
RAG_RRF_TOP_K=30
RAG_MAX_CHUNKS_PER_SOURCE=2
RAG_EXPANSION_ENABLED=true
RAG_BM25_ENABLED=true
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
RAG_RERANKER_DEVICE=auto
RAG_RERANKER_BATCH_SIZE=8
RAG_RERANKER_USE_FP16=true
RAG_RERANKER_CACHE_DIR=
RAG_MIN_RERANKER_SCORE=0.1
RAG_MODEL_MAX_CONCURRENCY=1
RAG_EXPANSION_CACHE_SIZE=512
CHUNK_MAX_SIZE=400
CHUNK_OVERLAP=64
RAG_SPLITTER_STRATEGY=markdown-header
CHUNK_LENGTH_UNIT=token
CORPUS_VERSION=aiops-runbook-v3

# MCP servers
MCP_CLS_HOST=127.0.0.1
MCP_CLS_PORT=8003
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_HOST=127.0.0.1
MCP_MONITOR_PORT=8004
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_OPS_HOST=127.0.0.1
MCP_OPS_PORT=8005
MCP_OPS_URL=http://localhost:8005/mcp

# Optional integrations (integrations/). Comma-separated; empty means none, which
# is the default -- the core agent needs no external platform to run.
AIOPS_ENABLED_INTEGRATIONS=

# Pin the tool used by /api/observability/trace-probe. Empty picks the first
# registered read-only tool, keeping the probe vendor-neutral.
AIOPS_TRACE_PROBE_TOOL=

# --- Settings below only apply when the matching integration is enabled ---
# integrations/windos: read-only diagnostics against a separate in-house system.
# Use a viewer-only API key when auth is enforced.
WINDOS_BASE_URL=http://127.0.0.1:8002
WINDOS_API_KEY=
WINDOS_TIMEOUT_SECONDS=8

# Read-only diagnostics used by the extended Ops MCP catalog.
PROMETHEUS_URL=http://127.0.0.1:9090
KUBERNETES_API_URL=
KUBERNETES_TOKEN=
KUBERNETES_VERIFY_TLS=true
DOCKER_API_URL=
REDIS_DIAGNOSTIC_URL=redis://127.0.0.1:6389/0
DIAGNOSTIC_ALLOWED_HOSTS=localhost,127.0.0.1
DIAGNOSTIC_TIMEOUT_SECONDS=8

# MySQL: create and use a SELECT-only account in non-production environments.
# Local demo from demo-mysql.yml. Replace for a real environment.
MYSQL_DSN=mysql+pymysql://oncall_reader:oncall_reader_demo@127.0.0.1:3307/observability
MYSQL_ALLOWED_SCHEMAS=observability
MYSQL_QUERY_TIMEOUT_SECONDS=10
MYSQL_MAX_ROWS=200

# Web search
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# Loki log backend for real log retrieval (empty = tool reports not configured).
LOKI_URL=

# --- AI Native OS Agent capabilities (P0/P1) ---
# Episodic memory: auto-capture diagnosis episodes and recall similar incidents
AIOPS_INCIDENT_MEMORY_ENABLED=true
AIOPS_INCIDENT_MEMORY_PATH=.runtime/incident_memory.jsonl
AIOPS_INCIDENT_MEMORY_TOP_K=2
AIOPS_INCIDENT_MEMORY_MAX_EPISODES=500
AIOPS_INCIDENT_MEMORY_MIN_SCORE=0.15

# Event-driven incidents: Alertmanager webhook ingestion + autonomous diagnosis
AIOPS_INCIDENT_DEDUP_WINDOW_SECONDS=300
AIOPS_INCIDENT_AUTONOMOUS_DIAGNOSIS_ENABLED=true
AIOPS_INCIDENT_MAX_CONCURRENT_DIAGNOSES=2
AIOPS_INCIDENT_NOTIFY_WEBHOOK_URL=
# 启用的通知渠道，逗号分隔。留空且 URL 已配置时兼容 legacy 单 webhook。
# 支持：webhook,slack,feishu（slack/feishu 为占位骨架，接入后自动生效）
AIOPS_INCIDENT_NOTIFIERS=
AIOPS_INCIDENT_SLACK_WEBHOOK_URL=
AIOPS_INCIDENT_FEISHU_WEBHOOK_URL=
AIOPS_INCIDENT_STORE_MAX=200

# Tool governance: injection defense output cap and action proposal TTL
AIOPS_TOOL_OUTPUT_MAX_CHARS=8000
AIOPS_ACTION_PROPOSAL_TTL_SECONDS=3600

# Service topology (P2.2): dependency graph JSON; empty = built-in demo topology
AIOPS_TOPOLOGY_PATH=
# Playbook library (P2.4): JSONL path; empty = built-in demo playbooks
AIOPS_PLAYBOOKS_PATH=
AIOPS_PLAYBOOK_TOP_K=2
AIOPS_PLAYBOOK_MIN_SCORE=0.15
